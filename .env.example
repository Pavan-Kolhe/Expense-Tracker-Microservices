# Copy this file to .env and fill in real values before running docker compose up.
# .env is gitignored — never commit real secrets.

# ===============================
# MySQL (shared instance, 3 DBs)
# ===============================
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USERNAME=root
DB_PASSWORD=change_me_root_password
DB_HOST=mysql
DB_PORT=3306

# ===============================
# JWT (Auth service + Kong must agree on this)
# ===============================
# Example valid 32-byte base64 secret — replace for anything beyond local testing.
JWT_SECRET=g6Zm7rHuT0MdEB6I8aaFCaSmIgFDlSl3AZAVoGRy4Gs=
JWT_EXPIRATION=86400000
REFRESH_TOKEN_EXPIRY=2592000000

# ===============================
# Kafka
# ===============================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ===============================
# dsService (Flask + Mistral LLM)
# ===============================
# NOTE: despite the variable name, this is your Mistral API key (a quirk
# in the original code — llmService.py reads OPENAI_API_KEY but passes it
# to ChatMistralAI). Get a key at https://console.mistral.ai
OPENAI_API_KEY=your_mistral_api_key_here
KAFKA_HOST=kafka
KAFKA_PORT=9092